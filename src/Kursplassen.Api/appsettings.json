{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Kursplassen.Api.Middleware.RequestLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false,
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "JWT":  {
    "ValueAudience": "User",
    "ValidIssuer": "http://ocalhost:5029",
    "SecretKey": "this-IS-Just-A-secret-key"
  }
}
